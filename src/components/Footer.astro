---
import { Compass, Github, Linkedin, Mail } from 'lucide-astro';
import { getSiteConfig } from '../data/site';
import AsciiBackdrop from './AsciiBackdrop.astro';

const { profile, site } = await getSiteConfig();
const year = new Date().getFullYear();
---

<footer>
  <p>
    {`© ${year} ${profile.name}`}{site.footerNote && ` · ${site.footerNote}`}
  </p>
  <div class="social-links">
    <a href={profile.website} target="_blank" rel="noreferrer">
      <span class="sr-only">Open website</span>
      <Compass size={18} stroke-width={1.9} aria-hidden="true" focusable="false" />
    </a>
    <a href={profile.github} target="_blank" rel="noreferrer">
      <span class="sr-only">Open GitHub profile</span>
      <Github size={18} stroke-width={1.9} aria-hidden="true" focusable="false" />
    </a>
    {
      profile.linkedin && (
        <a href={profile.linkedin} target="_blank" rel="noreferrer">
          <span class="sr-only">Open LinkedIn profile</span>
          <Linkedin size={18} stroke-width={1.9} aria-hidden="true" focusable="false" />
        </a>
      )
    }
    <a href={`mailto:${profile.email}`}>
      <span class="sr-only">Email</span>
      <Mail size={18} stroke-width={1.9} aria-hidden="true" focusable="false" />
    </a>
  </div>
  <div class="page-backdrop" data-pagefind-ignore>
    <AsciiBackdrop />
  </div>
</footer>

<style>
  .page-backdrop {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: -1;
    height: 420px;
    pointer-events: none;
  }

  .page-backdrop :global(.ascii-backdrop) {
    height: 100%;
  }

  footer {
    padding: 3em 1em 6em;
    color: var(--paper-ink-faint);
    font-size: 0.88rem;
    text-align: center;
  }

  p {
    margin: 0;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 1em;
    margin-top: 1em;
  }

  .social-links a {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--paper-ink-soft);
    text-decoration: none;
  }

  .social-links a:hover {
    color: var(--paper-accent);
  }
</style>
