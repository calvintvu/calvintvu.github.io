---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import FallbackImage from '../assets/og-default.png';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props;
const { site, fonts } = await getSiteConfig();
---

<link
  rel="preload"
  href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/fonts/nordwand-mono/NordwandMono-Regular.woff2`}
  as="font"
  type="font/woff2"
  crossorigin
/>
<meta name="application-name" content="calvintvu" />
<meta name="apple-mobile-web-app-title" content="calvintvu" />
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`}
/>
<ThemeBaseHead
  title={title}
  description={description}
  image={image}
  fallbackImage={FallbackImage}
  site={site}
  fonts={fonts}
/>
