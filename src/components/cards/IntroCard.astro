---
interface Intro {
  body: string[];
}

const { intro } = Astro.props as { intro: Intro };

type Segment = { text: string; href?: string };

/** Splits a line on markdown-style links: "at [centauri ai](https://centauri-ai.tech/)". */
function toSegments(line: string): Segment[] {
  const segments: Segment[] = [];
  let lastIndex = 0;
  for (const match of line.matchAll(/\[([^\]]+)\]\(([^)\s]+)\)/g)) {
    if (match.index > lastIndex) segments.push({ text: line.slice(lastIndex, match.index) });
    segments.push({ text: match[1], href: match[2] });
    lastIndex = match.index + match[0].length;
  }
  if (lastIndex < line.length) segments.push({ text: line.slice(lastIndex) });
  return segments;
}

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<article class="intro-card">
  {
    intro.body.map((line) => (
      <p>
        {toSegments(line).map((segment) =>
          segment.href ? (
            <a
              href={segment.href}
              target={isExternal(segment.href) ? '_blank' : undefined}
              rel={isExternal(segment.href) ? 'noreferrer' : undefined}
            >
              {segment.text}
            </a>
          ) : (
            segment.text
          ),
        )}
      </p>
    ))
  }
</article>

<style>
  .intro-card {
    display: grid;
    gap: 12px;
  }

  p {
    margin: 0;
    max-width: 62ch;
    color: var(--paper-ink);
    font-size: 1.02rem;
    line-height: 1.85;
  }

  a {
    color: var(--paper-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }
</style>
