---
interface Profile {
  name: string;
}

const { profile } = Astro.props as { profile: Profile };
---

<article class="profile-card">
  <h1>{profile.name}</h1>
</article>

<style>
  .profile-card {
    display: grid;
    justify-items: end;
    width: 100%;
    text-align: right;
  }

  h1 {
    margin: 0;
    color: var(--paper-ink);
    font-size: 1.42rem;
    line-height: 1.2;
    letter-spacing: 0;
  }
</style>
