---
import { ArrowUpRight } from 'lucide-astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import BlogTopNav from '../components/blog/BlogTopNav.astro';
import { getSiteConfig } from '../data/site';
import { getMusicReleases } from '../utils/music-releases';
import { getHtmlLang } from '../utils/ui-text';

const siteConfig = await getSiteConfig();
const { site, theme, pages } = siteConfig;
const pageMeta = pages.media;
const htmlLang = getHtmlLang(siteConfig);

const spotifySinglesUrl =
  'https://open.spotify.com/artist/5RyoiSpMzk9O63yAnkKN3q/discography/single';
const singles = await getMusicReleases(299838361);
const travelVideos = [
  { id: 'liIIrnQlri0', title: 'Japan Vol. I' },
  { id: 'iAtxMqSR6g0', title: 'Japan Vol. II' },
  { id: '02dVKyi_txM', title: 'Việtnam Vol. I' },
  { id: 'C5we2O1SV8A', title: 'Việtnam Vol. II' },
  { id: 'AI6HC1TQbm8', title: 'Tokyo Nights (Official Video)' },
];

type Tile = { title: string; meta: string; href: string; image: string };

const sections: {
  id: string;
  label: string;
  description: string;
  tiles?: Tile[];
  tileAspect?: 'square' | 'wide';
  links: { title: string; meta: string; href: string }[];
}[] = [
  {
    id: 'music',
    label: 'my music',
    description: 'singles on spotify',
    tileAspect: 'square',
    tiles: singles.map((single) => ({
      title: single.title,
      meta: single.releaseDate.slice(0, 4),
      href: spotifySinglesUrl,
      image: single.cover,
    })),
    links: [
      {
        title: 'Calvin Vuxar',
        meta: 'Spotify · singles',
        href: spotifySinglesUrl,
      },
    ],
  },
  {
    id: 'videography',
    label: 'my videos',
    description: '',
    tileAspect: 'wide',
    tiles: travelVideos.map((video) => ({
      title: video.title,
      meta: 'YouTube',
      href: `https://www.youtube.com/watch?v=${video.id}`,
      image: `https://i.ytimg.com/vi/${video.id}/maxresdefault.jpg`,
    })),
    links: [
      {
        title: 'All videos',
        meta: 'YouTube · @calvinvuxar',
        href: 'https://www.youtube.com/@calvinvuxar/videos',
      },
    ],
  },
  {
    id: 'links',
    label: 'links',
    description: 'everything in one place',
    links: [
      {
        title: 'Calvin Vuxar',
        meta: 'Linktree · @calvinvuxar',
        href: 'https://linktr.ee/calvinvuxar',
      },
    ],
  },
];
---

<!doctype html>
<html lang={htmlLang} data-palette={theme.palette}>
  <head>
    <BaseHead title={`${pageMeta.title} | ${site.title}`} description={pageMeta.subtitle} />
    <style>
      html {
        scroll-behavior: smooth;
      }
      main {
        width: min(100%, var(--layout-shell-width));
        padding-top: 126px;
      }
      .media-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 156px;
        gap: clamp(28px, 5vw, 68px);
      }
      .media-hero {
        margin-bottom: clamp(46px, 8vw, 88px);
      }
      .media-kicker,
      .media-count,
      .media-link-meta,
      .media-nav p,
      .media-nav a {
        font-family: var(--font-meta);
      }
      .media-kicker {
        margin: 0 0 12px;
        color: var(--paper-ink-faint);
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .media-title {
        max-width: 560px;
        margin: 0;
        color: var(--paper-ink);
        font-size: clamp(2.32rem, 6.6vw, 4.35rem);
        font-weight: 400;
        line-height: 0.96;
      }
      .media-subtitle {
        max-width: 34ch;
        margin: 18px 0 0;
        color: var(--paper-ink-soft);
        font-family: var(--font-ui-label);
        font-size: clamp(0.98rem, 1.7vw, 1.16rem);
        line-height: 1.68;
      }
      .media-note {
        max-width: 48ch;
        margin: 14px 0 0;
        color: var(--paper-ink-faint);
        font-size: 0.7rem;
        line-height: 1.75;
      }
      .media-section {
        scroll-margin-top: 92px;
        padding: 26px 0 clamp(48px, 8vw, 88px);
        border-top: 1px solid var(--paper-line);
      }
      .media-section:first-of-type {
        border-top: 0;
        padding-top: 0;
      }
      .media-section-heading {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: baseline;
        margin-bottom: 20px;
      }
      .media-section-heading h2 {
        margin: 0;
        color: var(--paper-ink);
        font-size: clamp(1.45rem, 3vw, 2rem);
        font-weight: 400;
      }
      .media-count {
        color: var(--paper-ink-faint);
        font-size: 0.7rem;
      }
      .media-links {
        display: grid;
        gap: 12px;
      }
      .media-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 18px;
        border: 1px solid var(--paper-line);
        border-radius: 7px;
        background: var(--paper-surface-muted);
        color: var(--paper-ink);
        text-decoration: none;
        transition:
          border-color 160ms ease,
          color 160ms ease;
      }
      .media-link:hover {
        border-color: var(--paper-accent);
        color: var(--paper-accent);
      }
      .media-link strong {
        display: block;
        font-family: var(--font-ui-label);
        font-size: 0.95rem;
        font-weight: 500;
      }
      .media-link-meta {
        display: block;
        margin-top: 4px;
        color: var(--paper-ink-faint);
        font-size: 0.68rem;
      }
      .media-tiles {
        display: grid;
        gap: 22px 14px;
        margin-bottom: 22px;
      }
      .media-tiles--square {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      }
      .media-tiles--wide {
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      }
      .media-tile {
        min-width: 0;
        color: var(--paper-ink);
        text-decoration: none;
      }
      .media-tile img {
        display: block;
        width: 100%;
        margin-bottom: 10px;
        border: 1px solid var(--paper-line);
        border-radius: 7px;
        background: var(--paper-surface-muted);
        object-fit: cover;
        transition: border-color 160ms ease;
      }
      .media-tiles--square img {
        aspect-ratio: 1;
      }
      .media-tiles--wide img {
        aspect-ratio: 3 / 2;
      }
      .media-tile strong {
        display: block;
        overflow: hidden;
        font-family: var(--font-ui-label);
        font-size: 0.87rem;
        font-weight: 500;
        line-height: 1.4;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .media-tile:hover strong {
        color: var(--paper-accent);
      }
      .media-tile:hover img {
        border-color: var(--paper-accent);
      }
      @media (max-width: 430px) {
        .media-tiles--square {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .media-tiles--wide {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      .media-nav {
        align-self: start;
        position: sticky;
        top: 102px;
        border-left: 1px solid var(--paper-line);
        padding-left: 16px;
      }
      .media-nav p {
        margin: 0 0 8px;
        color: var(--paper-ink-faint);
        font-size: 0.66rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .media-nav a {
        display: block;
        padding: 7px 0;
        color: var(--paper-ink-faint);
        font-size: 0.72rem;
        text-decoration: none;
        transition: color 160ms ease;
      }
      .media-nav a:hover {
        color: var(--paper-ink);
      }
      @media (max-width: 760px) {
        main {
          padding-top: 98px;
        }
        .media-layout {
          display: block;
        }
        .media-nav {
          display: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </head>
  <body>
    <BlogTopNav />
    <main>
      <div class="media-layout">
        <div>
          <header class="media-hero">
            <p class="media-kicker">Media shelf</p>
            <h1 class="media-title">{pageMeta.title}</h1>
            <p class="media-subtitle">{pageMeta.subtitle}</p>
            <p class="media-note">{pageMeta.note}</p>
          </header>
          {
            sections.map((section) => (
              <section class="media-section" id={section.id}>
                <div class="media-section-heading">
                  <h2>{section.label}</h2>
                  <span class="media-count">{section.description}</span>
                </div>
                {section.tiles?.length ? (
                  <div class:list={['media-tiles', `media-tiles--${section.tileAspect}`]}>
                    {section.tiles.map((tile) => (
                      <a class="media-tile" href={tile.href} target="_blank" rel="noreferrer">
                        <img
                          src={tile.image}
                          alt={`${tile.title} cover`}
                          loading="lazy"
                          decoding="async"
                        />
                        <strong>{tile.title}</strong>
                        <span class="media-link-meta">{tile.meta}</span>
                      </a>
                    ))}
                  </div>
                ) : null}
                <div class="media-links">
                  {section.links.map((link) => (
                    <a class="media-link" href={link.href} target="_blank" rel="noreferrer">
                      <span>
                        <strong>{link.title}</strong>
                        <span class="media-link-meta">{link.meta}</span>
                      </span>
                      <ArrowUpRight size={18} strokeWidth={1.6} aria-hidden="true" />
                    </a>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
        <nav class="media-nav" aria-label="Media sections">
          <p>Browse</p>
          {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
        </nav>
      </div>
    </main>
    <Footer />
  </body>
</html>
